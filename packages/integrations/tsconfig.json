{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@coherent.js/core": [
        "../core/dist"
      ],
      "@coherent.js/client": [
        "../client/dist"
      ],
      "@coherent.js/integrations": [
        "./dist"
      ]
    }
  },
  "include": [
    "src/**/*",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.js"
  ],
  "references": [
    {
      "path": "../core/tsconfig.json"
    },
    {
      "path": "../client/tsconfig.json"
    }
  ]
}
