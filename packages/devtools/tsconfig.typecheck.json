{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": false,
    "paths": {
      "@coherent.js/core": ["../core/types/index.d.ts"]
    },
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false
  },
  "include": ["types/**/*.d.ts"]
}
