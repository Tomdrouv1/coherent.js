{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "paths": {
      "@coherent.js/core": [
        "../core/dist"
      ],
      "@coherent.js/client": [
        "./dist"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../core/tsconfig.json"
    }
  ]
}
