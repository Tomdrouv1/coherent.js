{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.js",
    "**/*.test.ts"
  ]
}
